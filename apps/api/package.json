{
  "name": "@rag/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "dev": "nodemon --watch src --watch ../../packages/config/dist --watch ../../packages/contracts/dist --watch ../../packages/database/dist --watch ../../packages/observability/dist --watch ../../packages/rag-core/dist --ext ts,js --exec \"node -r ts-node/register/transpile-only src/main.ts\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@rag/config": "workspace:*",
    "@rag/contracts": "workspace:*",
    "@rag/database": "workspace:*",
    "@rag/observability": "workspace:*",
    "@rag/rag-core": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2"
  }
}
