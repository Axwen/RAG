# ── 外部参考快照(按设计 §7 固定 commit,可随时重新拉取,不进版本库)──
/references/

# ── 学习资料 / 输入素材(大二进制)──
/pdf/

# ── 本地工具与会话状态 ──
/.gstack/
/.gstack-design-source
/.claude/settings.local.json

