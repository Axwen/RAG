# 阶段 1 本地开发环境变量样例（T0）
# 只包含无敏感默认值与变量说明。真实 Token、密码和模型密钥只允许来自未跟踪的 .env
# 或运行环境，禁止写入本文件或任何进入版本库的文件。
# 用法：cp .env.example .env  然后按注释填入本地值。
# Compose 命令以仓库根为 project directory，存在 .env 时自动读取；应用进程只读取
# 外围环境变量，本地也可通过 source/direnv/IDE 注入，CI 与部署由运行环境注入。

# ── 运行环境 ──
# Compose 项目名，决定容器与卷前缀；改名即可在同一台机器上并行开多套本地环境
COMPOSE_PROJECT_NAME=rag-local
NODE_ENV=development
LOG_LEVEL=debug
# api / web / worker 监听端口
API_PORT=3001
WEB_PORT=3000
PARSER_PORT=8100
# worker 健康入口端口（/health/live 与 /health/ready）
WORKER_HEALTH_PORT=3002
# Web 服务端访问 API 的地址；不注入客户端包
API_BASE_URL=http://localhost:3001

# ── PostgreSQL（业务事实、任务状态、Outbox、审计、删除的唯一权威）──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
# 本地开发口令占位；真实值放未跟踪 .env
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://rag:CHANGE_ME_LOCAL_ONLY@localhost:5432/rag?schema=public

# ── OpenSearch（索引物理作用域 tenant_id + knowledge_space_id + index_partition_id）──
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_PORT=9200
# PROBE-003 实测版本 2.19.1；本地单节点关闭安全插件，不代表生产配置
OPENSEARCH_REQUEST_TIMEOUT_MS=250

# ── RabbitMQ（只负责传输与延迟，不作为状态权威）──
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=rag
RABBITMQ_PASSWORD=CHANGE_ME_LOCAL_ONLY
RABBITMQ_VHOST=/

# ── Redis（SSE 续读窗 run:{runId}:events，TTL 24h）──
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_SSE_TTL_SECONDS=86400

# ── MinIO（对象存储；正式快照是正文的唯一长期副本）──
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ragadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY
MINIO_BUCKET=rag-local

# ── Keycloak / OIDC（PROBE-001 实测版本 26.2.5；只证明主体身份，不等于业务授权）──
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=rag-local
KEYCLOAK_CLIENT_ID=rag-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
DEV_USER_NAME=dev
DEV_USER_PASSWORD=CHANGE_ME_LOCAL_ONLY

# ── 云模型（ADR-0017；密钥只来自运行环境，占位值必须无效）──
# Embedding + Reranker：OpenRouter，同一 base 与同一 key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-INVALID-PLACEHOLDER-DO-NOT-COMMIT-REAL-KEY
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
RERANKER_MODEL=qwen/qwen3-reranker-8b
# Chat / 高风险蕴含：fluxionai，OpenAI Responses 协议
FLUXIONAI_BASE_URL=https://api.fluxionai.com/v1
FLUXIONAI_API_KEY=sk-INVALID-PLACEHOLDER-DO-NOT-COMMIT-REAL-KEY
CHAT_MODEL=gpt-5.6-terra
# 解析链路零云调用（ADR-0038）：图片/Office 走本地 DeepDOC OCR 与格式库，不设云模型变量

# ── 预算硬门禁（ADR-0029；T12 落地强制，T0 只校验配置 schema）──
BUDGET_SINGLE_CALL_CNY=5
BUDGET_DAILY_CNY=16
BUDGET_MONTHLY_CNY=500

# ── Worker Profile 资源边界（ADR-0025；T10 落地运行时强制）──
WORKER_PROFILE=ingestion
WORKER_INGESTION_CONCURRENCY=4
WORKER_INGESTION_IN_FLIGHT=8
WORKER_EVALUATION_CONCURRENCY=1
WORKER_EVALUATION_IN_FLIGHT=1
# evaluation profile 容器的宿主健康端口（与 WORKER_HEALTH_PORT 不同，避免本地端口冲突）
WORKER_EVALUATION_HEALTH_PORT=3003

# ── Parser 容器（parser profile）──
# 容器内存上限；DeepDOC RSS 警戒 8 GiB，留出堆外与系统余量
PARSER_MEMORY_LIMIT=10g
