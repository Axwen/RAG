{
  "name": "rag-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "企业级可信多模态 RAG 阶段 1 monorepo 基线（T0）",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "22.23.1",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm --recursive --stream run typecheck && tsc -p tsconfig.test.json",
    "build": "pnpm --recursive --stream run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "bash scripts/check-env.sh",
    "dx:baseline": "bash scripts/dx-baseline.sh",
    "check:links": "bash scripts/check-links.sh",
    "check:commits": "bash scripts/check-commits.sh",
    "check:shell": "bash scripts/check-shell.sh",
    "check:workflows": "bash scripts/check-workflows.sh",
    "check:diff-coverage": "bash scripts/check-diff-coverage.sh",
    "check:parser-image": "bash scripts/check-parser-image.sh",
    "smoke:api": "bash scripts/smoke-api.sh",
    "test:coverage": "vitest run --coverage",
    "postinstall": "pnpm --filter @rag/database run generate",
    "db:validate": "pnpm --filter @rag/database run validate",
    "db:migrate": "pnpm --filter @rag/database run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @rag/database run migrate:deploy",
    "db:seed": "pnpm --filter @rag/database run seed",
    "py:sync": "cd services/parser && UV_CACHE_DIR=.uv-cache uv sync --frozen",
    "py:test": "cd services/parser && UV_CACHE_DIR=.uv-cache uv run pytest -q",
    "infra:up": "pnpm run preflight && docker compose --project-directory . -f infra/compose/compose.yml up -d --wait",
    "infra:up:parser": "docker compose --project-directory . -f infra/compose/compose.yml --profile parser up -d --wait",
    "infra:up:evaluation": "docker compose --project-directory . -f infra/compose/compose.yml --profile evaluation up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/compose/compose.yml down",
    "infra:reset": "docker compose --project-directory . -f infra/compose/compose.yml down -v",
    "compose:config": "docker compose --project-directory . -f infra/compose/compose.yml --profile parser --profile evaluation config -q",
    "bootstrap": "bash infra/compose/init/init-all.sh",
    "verify": "pnpm run format && pnpm run lint && pnpm run check:shell && pnpm run check:workflows && pnpm run check:links && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run db:validate && pnpm run py:sync && pnpm run py:test && pnpm run compose:config"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
