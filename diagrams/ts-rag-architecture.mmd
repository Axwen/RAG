  class WEB,ADMIN,SDK,API,AUTH,SCOPE,ORCH,RECHECK,RESOLVE,ANSWER,CIT,FINAL,DOC,QP,DEL,OUTBOX,ING,SCAN,CHUNK,INDEX,SEARCH,VECTOR,GRAPH,RELEASE,VALIDATE,ALIAS,EVAL,CLEAN,REPLAY ts;
  class PG,LEDGER,OS,OBJ,REDIS,Q,NEO4J data;
  class PARSE,MODEL,CLOUD model;
  class OTEL,OBS ops;
