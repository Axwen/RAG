// 阶段 1 数据库 schema。
//
// PostgreSQL 是业务事实、任务状态、Outbox、审计与删除记录的唯一权威
// （ADR-0001/0003）。领域模型按票据顺序加入，全部通过 Prisma Migrate 生成
// 受版本控制的迁移 SQL：
// - T1a：租户、知识空间、不可变文档版本、内容寻址 Manifest、Pipeline 兼容组合、
//   Release 与 IndexPartition 表结构（ADR-0028/0036）
// - T1b：chunk_manifest 与最终 Chunk 字段（PROBE-006 冻结后）
// - T2：正交状态命令与状态迁移事实
// - T3：Outbox 与事件投递事实
// - T12a：model_budget_ledger 模型预算账本（ADR-0029）
// - T11a：domain_audit_event 同步领域审计（ADR-0040）
// - T14a：业务身份 7 张表——BusinessUser/TenantMembership/Workspace/
//   WorkspaceMembership/Role/Permission/RolePermission（ADR-0039）
//
// 边界约定（ADR-0036 §4）：
// - 所有表都带 tenantId；租户是最高隔离域，即使阶段 1 只有一个租户。
// - Manifest 是内容寻址、不可变对象：(tenantId, contentHash) 唯一，APPROVED 后
//   不得修改，任何引用字段变化必须新建。
// - PipelineManifest 只表达一个已批准兼容组合，不是 Release 的父对象。
// - ReleaseManifest 不写回激活时间或当前 Alias；激活事实由 ReleaseActivation
//   记录（T5）。T1a 只落表结构与 CREATED 初始态。
// - 复合外键的约束名用 @relation(map:) 钉住，与迁移 20260828130000_manifest_immutability
//   的手写 SQL 对齐。不声明 map 时 Prisma 按字段名推导出另一套名字，schema 与迁移
//   历史会长期漂移，任何人跑 `prisma migrate dev` 都会被要求 reset 开发库。
//
// 生成器选择 `prisma-client` 而不是已弃用的 `prisma-client-js`；
// `moduleFormat = "cjs"` 与仓库统一的 CommonJS 产物一致（NestJS 与 Worker 都是 CJS）。
// 生成产物落在 src/generated/prisma 并被 .gitignore 忽略，安装后由 `pnpm db:generate` 重建。
//
// Prisma 7 起 datasource 块不再接受 `url`：迁移用的连接串只在 prisma.config.ts 里
// 通过 env('DATABASE_URL') 提供，运行时连接由 PrismaClient 的 driver adapter
// （@prisma/adapter-pg）注入。因此本文件不含、也不允许含任何连接串。

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ─── 数据等级（ADR-0025）───────────────────────────────────────────────
// UNKNOWN/SENSITIVE 不允许进入云执行区；等级变化创建新 IndexPartition。

enum DataClass {
  UNKNOWN
  PUBLIC
  INTERNAL
  CONTROLLED
  SENSITIVE
}

// ─── Manifest 生命周期 ────────────────────────────────────────────────
// Manifest 只有 DRAFT -> APPROVED 一条合法迁移；APPROVED 后内容不可变
// （不可变约束见 ADR-0036 §4.2：任何字段变化必须新建 Manifest）。

enum ManifestStatus {
  DRAFT
  APPROVED
}

// ─── 发布状态（ADR-0036 §4.4）────────────────────────────────────────
// T1a 只允许创建（CREATED）；BUILDING 及之后的迁移由 T5 的领域命令驱动，
// 不提供通用 PATCH status。

enum ReleaseStatus {
  CREATED
  BUILDING
  VALIDATING
  READY
  ACTIVE
  SUPERSEDED
  ROLLING_BACK
  FAILED
  ABORTED
}

// ─── 模型预算账本（ADR-0029）─────────────────────────────────────────
// 一行 = 一次「打算花钱」的完整生命周期，不是流水日志。合法转移只有三条：
// RESERVED → SETTLED / RELEASED / EXPIRED，因此终态时间戳只需要一个。

enum BudgetPool {
  INTERACTIVE
  EVALUATION
  RESERVE
}

enum BudgetLedgerStatus {
  RESERVED
  SETTLED
  RELEASED
  EXPIRED
}

// 结算金额的来源。供应商在 usage 里返回 cost 时记 PROVIDER；没返回时记
// ESTIMATED 并落本地估值，差额本身是审计对象（ADR-0029 第 17 行）。
enum BudgetCostSource {
  PROVIDER
  ESTIMATED
}

// 释放只用于调用确实没发生。客户端超时或挂起不得走这条——钱可能真花了，
// 那种情况留给 lease 过期回收（T12 票据不变量）。
enum BudgetReleaseReason {
  GATED
  CANCELLED_BEFORE_DISPATCH
}

// ─── 领域审计（ADR-0040）─────────────────────────────────────────────
// 一行 = 一次领域判定的事实，不是访问日志。频次类软门（429）只计指标、
// 不写这张表（ADR-0034 第 11 行）。一张表两个分域维度：category 用于翻页与
// 索引，reasonCode 用于精确断言，唯一来源是契约包的注册表（ADR-0040 决策 3）。

enum AuditCategory {
  BUDGET
  AUTHZ
  MEMBERSHIP
  DATA_CLASS
  INJECTION
  EVIDENCE
  DELETION
}

// SYSTEM 用于没有业务用户的系统动作（lease 回收、对账），此时 actorId 记
// 动作名而不是 uuid，因此 actorId 是 String 而不是 @db.Uuid。
enum AuditActorType {
  BUSINESS_USER
  SYSTEM
}

// 域内语义不同但读侧口径统一，便于「查这个租户所有 DENIED」。
enum AuditOutcome {
  ALLOWED
  DENIED
  DEGRADED
  RECLAIMED
}

// ─── 业务身份（ADR-0039 / T14a）─────────────────────────────────────
// 身份层的两张跨租户表（business_users、permissions）不带 tenantId：
// 同一 BusinessUser 可加入多个租户（ADR-0039 决策 3），主体表挂租户就
// 表达不了这件事；能力权限码是全局稳定字典，也不按租户复制。
// 这是身份层对「所有表都带 tenantId」（ADR-0036 §4）的唯一偏离，租户
// 隔离由两张 membership 表的 (tenantId, …) 唯一约束与租户级外键承担。

// BusinessUser 的业务状态：DISABLED 由业务库记录（ADR-0039 决策 1，
// 不依赖 Keycloak 侧禁用）；禁用后所有成员关系失效，重新启用不恢复
// 期间被撤销的成员关系。
enum BusinessUserStatus {
  ACTIVE
  DISABLED
}

// 成员关系状态：SUSPENDED 是可恢复的暂停（保留关系，暂时无权），
// REVOKED 是终态撤权（ADR-0039：撤权必须由业务库记录并审计）。
enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// 角色的作用域：TENANT 角色由 TenantMembership 引用（租户级管理），
// WORKSPACE 角色由 WorkspaceMembership 引用（工作台角色）。引用侧的
// 匹配由应用层校验并测试钉住——Prisma 不支持带条件的 FK，DB 层不强求。
enum RoleScope {
  TENANT
  WORKSPACE
}


// ─── 租户与知识空间（§4.1）────────────────────────────────────────────

model Tenant {
  id                  String              @id @default(uuid(7)) @db.Uuid
  name                String
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  knowledgeSpaces     KnowledgeSpace[]
  documents           Document[]
  documentVersions    DocumentVersion[]
  ingestionManifests  IngestionManifest[]
  retrievalManifests  RetrievalManifest[]
  answerManifests     AnswerManifest[]
  pipelineManifests   PipelineManifest[]
  indexPartitions     IndexPartition[]
  releaseManifests    ReleaseManifest[]
  budgetLedgerEntries ModelBudgetLedger[]
  domainAuditEvents   DomainAuditEvent[]
  tenantMemberships   TenantMembership[]
  workspaces          Workspace[]
  roles               Role[]

  @@map("tenants")
}

model KnowledgeSpace {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @db.Uuid
  slug             String
  name             String
  defaultDataClass DataClass         @default(INTERNAL)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  documents        Document[]
  indexPartitions  IndexPartition[]
  releaseManifests ReleaseManifest[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@map("knowledge_spaces")
}

// ─── 文档与不可变版本 ─────────────────────────────────────────────────
// DocumentVersion 一经创建不可修改；同一租户内 contentHash 唯一防止重复入库。
// 解析产物、Chunk 与投影状态由 T1b/T2/T4a 加入，本表不持有它们。

model Document {
  id               String            @id @default(uuid(7)) @db.Uuid
  tenantId         String            @db.Uuid
  knowledgeSpaceId String            @db.Uuid
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  knowledgeSpace   KnowledgeSpace    @relation(fields: [knowledgeSpaceId], references: [id])
  versions         DocumentVersion[]

  @@index([tenantId, knowledgeSpaceId])
  @@map("documents")
}

model DocumentVersion {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  documentId   String    @db.Uuid
  version      Int
  sourceFormat String
  dataClass    DataClass @default(INTERNAL)
  contentHash  String
  objectKey    String
  sizeBytes    Int
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  document     Document  @relation(fields: [documentId], references: [id])

  @@unique([documentId, version])
  @@unique([tenantId, contentHash])
  @@index([tenantId, documentId])
  @@map("document_versions")
}

// ─── 内容寻址 Manifest（ADR-0036 §4.2）───────────────────────────────
// 字段口径与工程评审闭合记录 §4.2 的表格一致。contentHash 由契约包的规范化
// JSON + SHA-256 计算（packages/contracts/src/manifests），数据库唯一约束兜底。

model IngestionManifest {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @db.Uuid
  version        Int
  status         ManifestStatus     @default(DRAFT)
  parserRef      String
  chunkerRef     String
  embeddingRef   String
  indexSchemaRef String
  // 解析后端标识（ADR-0038）：契约一次定形，默认 deepdoc；T4b 增量加入
  // office_hybrid/image_ocr 时只做增量实现，不改契约。
  parseBackend   String             @default("deepdoc")
  sourceFormats  String[]
  contentHash    String
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  approvedAt     DateTime?          @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  pipelines      PipelineManifest[]
  releases       ReleaseManifest[]

  @@unique([tenantId, contentHash])
  @@unique([tenantId, id])
  @@map("ingestion_manifests")
}

model RetrievalManifest {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @db.Uuid
  version         Int
  status          ManifestStatus     @default(DRAFT)
  sparsePolicy    Json
  vectorPolicy    Json
  fusionPolicy    Json
  rerankerRef     String
  candidateBudget Int
  // rerankInputSize 与 candidateBudget 分离（ADR-0035/PROBE-005）：前者是 OpenSearch
  // 融合候选上限（冻结 1024），后者是实际送入 Reranker 的候选数，既是调优参数也是
  // 预算参数。必须是 Manifest 字段而不是环境变量。开发种子显式写 64。
  rerankInputSize Int
  contentHash     String
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  approvedAt      DateTime?          @db.Timestamptz(6)
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  pipelines       PipelineManifest[]

  @@unique([tenantId, contentHash])
  @@unique([tenantId, id])
  @@map("retrieval_manifests")
}

model AnswerManifest {
  id             String             @id @default(uuid(7)) @db.Uuid
  tenantId       String             @db.Uuid
  version        Int
  status         ManifestStatus     @default(DRAFT)
  promptRef      String
  modelRouteRef  String
  citationPolicy Json
  riskPolicy     Json
  fallbackPolicy Json
  contentHash    String
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  approvedAt     DateTime?          @db.Timestamptz(6)
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  pipelines      PipelineManifest[]

  @@unique([tenantId, contentHash])
  @@unique([tenantId, id])
  @@map("answer_manifests")
}

// PipelineManifest：一个已批准的兼容组合，不是 Release 的父对象
// （ADR-0036 §4）。组合内任何 Manifest 版本变化必须新建 Pipeline。

model PipelineManifest {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @db.Uuid
  version             Int
  status              ManifestStatus    @default(DRAFT)
  ingestionManifestId String            @db.Uuid
  retrievalManifestId String            @db.Uuid
  answerManifestId    String            @db.Uuid
  compatibilityHash   String
  contentHash         String
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  approvedAt          DateTime?         @db.Timestamptz(6)
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  ingestionManifest   IngestionManifest @relation(fields: [tenantId, ingestionManifestId], references: [tenantId, id], map: "pipeline_manifests_tenant_ingestion_fkey")
  retrievalManifest   RetrievalManifest @relation(fields: [tenantId, retrievalManifestId], references: [tenantId, id], map: "pipeline_manifests_tenant_retrieval_fkey")
  answerManifest      AnswerManifest    @relation(fields: [tenantId, answerManifestId], references: [tenantId, id], map: "pipeline_manifests_tenant_answer_fkey")

  @@unique([tenantId, ingestionManifestId, retrievalManifestId, answerManifestId])
  @@unique([tenantId, contentHash])
  @@unique([tenantId, id])
  @@map("pipeline_manifests")
}

// ─── 索引分区（ADR-0028）─────────────────────────────────────────────
// 数据等级、索引 Schema 或 Embedding 版本变化创建新分区，不原地重写。

model IndexPartition {
  id                 String            @id @default(uuid(7)) @db.Uuid
  tenantId           String            @db.Uuid
  knowledgeSpaceId   String            @db.Uuid
  dataClass          DataClass
  indexSchemaVersion String
  embeddingVersion   String
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  knowledgeSpace     KnowledgeSpace    @relation(fields: [tenantId, knowledgeSpaceId], references: [tenantId, id], map: "index_partitions_tenant_knowledge_space_fkey")
  releaseManifests   ReleaseManifest[]

  @@unique([tenantId, knowledgeSpaceId, dataClass, indexSchemaVersion, embeddingVersion])
  @@unique([tenantId, id])
  @@map("index_partitions")
}

// ─── Release（ADR-0036 §4.2/§4.4）────────────────────────────────────
// 只表达入库事实与成员集；不写回激活时间、当前 Alias 或最终替代关系。

model ReleaseManifest {
  id                  String            @id @default(uuid(7)) @db.Uuid
  tenantId            String            @db.Uuid
  knowledgeSpaceId    String            @db.Uuid
  indexPartitionId    String            @db.Uuid
  ingestionManifestId String            @db.Uuid
  status              ReleaseStatus     @default(CREATED)
  memberSetUri        String
  memberSetHash       String
  memberCount         Int
  docIndexName        String
  chunkIndexName      String
  candidateAlias      String
  indexSchemaVersion  String
  embeddingVersion    String
  contentHash         String
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  knowledgeSpace      KnowledgeSpace    @relation(fields: [tenantId, knowledgeSpaceId], references: [tenantId, id], map: "release_manifests_tenant_knowledge_space_fkey")
  indexPartition      IndexPartition    @relation(fields: [tenantId, indexPartitionId], references: [tenantId, id], map: "release_manifests_tenant_partition_fkey")
  ingestionManifest   IngestionManifest @relation(fields: [tenantId, ingestionManifestId], references: [tenantId, id], map: "release_manifests_tenant_ingestion_fkey")

  @@unique([tenantId, contentHash])
  @@index([tenantId, knowledgeSpaceId])
  @@map("release_manifests")
}

// ─── 模型预算账本（ADR-0029 / T12a）──────────────────────────────────
// 余额的事实源只有这张表。Redis 可以缓存剩余额度用于展示和快速拒绝，
// 不得作为放行依据（T12 不变量第一条）。没有 RESERVED 记录的模型调用是缺陷。
//
// 三处刻意的取舍，实现时不要「补回来」：
// 1. 没有 period 列。票据写「period ∈ {日, 月}」，但一行预扣同时算进当日与
//    当月两个窗口，单值填不了；一行一窗口又会让账本翻倍。日/月窗口由应用
//    按 createdAt 范围 CAS，预算日的时区归 T12b 运行配置，不进 schema。
// 2. 终态时间戳只有 finalizedAt。RESERVED 之后恰好一次终态转移，
//    settledAt/releasedAt/expiredAt 三列里永远两列是空的。
// 3. answerRunId / jobId 暂无外键：AnswerRun 归 T7、job 归 T3，两张表都还
//    不存在。恰好一个非空由 CHECK 约束保证（见迁移 SQL）。

model ModelBudgetLedger {
  id             String               @id @default(uuid(7)) @db.Uuid
  tenantId       String               @db.Uuid
  // 幂等键让重放不重复扣款：命中已存在的行时返回那一行（replayed: true）。
  idempotencyKey String
  pool           BudgetPool
  status         BudgetLedgerStatus   @default(RESERVED)
  // 金额一律 Decimal(12, 6)：¥0.0012 这种四位小数在一个月的账本行上累加，
  // 浮点误差会变成对不上的账。actualAmount 结算前为空。
  reservedAmount Decimal              @db.Decimal(12, 6)
  actualAmount   Decimal?             @db.Decimal(12, 6)
  costSource     BudgetCostSource?
  releaseReason  BudgetReleaseReason?
  // 与金额分开记录，不把「当时的汇率」折进金额里（T12 不变量）。
  exchangeRate   Decimal              @db.Decimal(10, 6)
  leaseExpiresAt DateTime             @db.Timestamptz(6)
  // 续租次数只受配置的总时长上限约束；留计数便于对账看「谁在长调用」。
  renewCount     Int                  @default(0)
  answerRunId    String?              @db.Uuid
  jobId          String?              @db.Uuid
  // `@default(now())` 是 Prisma **客户端**生成的值，列的 DEFAULT 只兜住省略该列的原始 SQL。
  // 所以 reserveBudget 显式传 txNow(tx)：CAS 按事务时钟校验窗口，行必须落在同一个时刻上。
  createdAt      DateTime             @default(now()) @db.Timestamptz(6)
  finalizedAt    DateTime?            @db.Timestamptz(6)
  tenant         Tenant               @relation(fields: [tenantId], references: [id])

  // 幂等键按租户唯一：重放判定必须带租户谓词，不留按裸键查的口子。
  @@unique([tenantId, idempotencyKey])
  // 租户级外键的落点（references: [tenantId, id]），与其余模型同一口径。
  @@unique([tenantId, id])
  // 日/月/池三层 CAS 的求和路径：按租户 + 池 + 时间窗扫 RESERVED 与 SETTLED。
  @@index([tenantId, pool, status, createdAt])
  // lease 回收任务不带 tenantId（expireBudgetLeases(tx, { now, limit })），
  // 所以这个索引必须以 status 开头，否则回收会全表扫。
  @@index([status, leaseExpiresAt])
  @@index([tenantId, answerRunId])
  @@map("model_budget_ledger")
}

// ─── 领域审计（ADR-0040 / T11a）──────────────────────────────────────
// 审计行不可变，且不随业务数据删除而删除（含墓碑写入与 Legal Hold 释放）。
// 不可变由迁移里的 UPDATE/DELETE 阻断触发器保证，不靠评审提醒。
// 前提是 detail 不落正文：写入口在写库前强制过 redaction。

model DomainAuditEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  tenantId    String         @db.Uuid
  // 同 ModelBudgetLedger.createdAt：写入口显式传 txNow(tx)，列默认值只是原始 SQL 的兜底。
  occurredAt  DateTime       @default(now()) @db.Timestamptz(6)
  // category 由注册表按 reasonCode 派生（categoryForReasonCode），调用方不传；
  // 这一列是那个映射的反范式化，读侧要按它翻页和建索引。
  category    AuditCategory
  // 唯一来源是 packages/contracts/src/audit/reason-codes.ts。编译期由 satisfies
  // 保证已注册，库里再加一条格式 CHECK 兜住绕过 TS 的写入路径。
  reasonCode  String
  outcome     AuditOutcome
  actorType   AuditActorType
  // SYSTEM 动作记动作名（LEASE_REAPER / RECONCILER），所以不是 @db.Uuid。
  actorId     String?
  subjectType String?
  subjectId   String?
  detail      Json?
  // 审计不依赖遥测：拿不到 traceId 也必须写成功。
  traceId     String?
  tenant      Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  // 读侧是按租户 + 时间 + 域翻页；缺这两个索引，T8 的删除证明查询会全表扫。
  @@index([tenantId, occurredAt])
  @@index([tenantId, category, occurredAt])
  @@map("domain_audit_event")
}

// ─── 业务身份（ADR-0039 / T14a）─────────────────────────────────────
// OIDC 只证明主体是谁，业务身份事实全在本库（ADR-0039 决策 1）。
// 7 张表：BusinessUser / TenantMembership / Workspace / WorkspaceMembership /
// Role / Permission / RolePermission。成员→角色的绑定内嵌在两张 membership
// 表上（多角色 = 多条成员关系，不存在全局唯一业务角色）；同 Workspace 多
// 角色是扩展点，阶段 1 不建 UserRole 关联表。

// 本系统的业务主体主表：以 (issuer, subject) 唯一映射 Keycloak 身份。
// email 只作展示，可变且不参与任何键（ADR-0039 决策 1）；不保存密码。
model BusinessUser {
  id          String             @id @default(uuid(7)) @db.Uuid
  // 外部身份映射键：Keycloak 的 iss + sub，两者都不可变。
  issuer      String
  subject     String
  displayName String
  email       String?
  status      BusinessUserStatus @default(ACTIVE)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  tenantMemberships   TenantMembership[]
  workspaceMemberships WorkspaceMembership[]

  @@unique([issuer, subject])
  @@map("business_users")
}

// 业务用户与租户的成员关系；tenantRoleId 指向 scope=TENANT 的角色
// （租户级管理能力），普通成员可以为 null。租户与角色的复合外键保证同租户，
// 迁移中的数据库触发器再保证角色 scope=TENANT。
model TenantMembership {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @db.Uuid
  businessUserId  String           @db.Uuid
  status          MembershipStatus @default(ACTIVE)
  tenantRoleId    String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  revokedAt       DateTime?        @db.Timestamptz(6)
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  businessUser    BusinessUser     @relation(fields: [businessUserId], references: [id])
  tenantRole      Role?            @relation("TenantMembershipsByRole", fields: [tenantId, tenantRoleId], references: [tenantId, id], onDelete: Restrict, map: "tenant_memberships_tenant_role_fkey")

  @@unique([tenantId, businessUserId])
  @@unique([tenantId, id])
  @@index([businessUserId])
  @@map("tenant_memberships")
}

// 角色工作台（客服/研发/普通员工是不同的 Workspace，不是全局角色，
// ADR-0002/0039）。Workspace 是租户内实体，走租户级外键口径。
model Workspace {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  slug      String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  members   WorkspaceMembership[]

  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@map("workspaces")
}

// 业务用户与 Workspace 的成员关系；roleId 指向 scope=WORKSPACE 的角色。
// 切换 Workspace 不继承上一 Workspace 的资源范围（ADR-0039 决策 3），
// 所以身份上下文装配必须按 Workspace 分别取角色，不合并。复合外键保证同租户，
// 迁移中的数据库触发器再保证角色 scope=WORKSPACE。
model WorkspaceMembership {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @db.Uuid
  workspaceId    String           @db.Uuid
  businessUserId String           @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  roleId         String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  revokedAt      DateTime?        @db.Timestamptz(6)
  workspace      Workspace        @relation(fields: [tenantId, workspaceId], references: [tenantId, id])
  businessUser   BusinessUser     @relation(fields: [businessUserId], references: [id])
  role           Role?            @relation("WorkspaceMembershipsByRole", fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, map: "workspace_memberships_tenant_role_fkey")

  @@unique([workspaceId, businessUserId])
  @@unique([tenantId, id])
  @@index([businessUserId])
  @@map("workspace_memberships")
}

// 功能角色。code 在租户内稳定（如 'tenant-admin' / 'agent' / 'engineer'）；
// scope 决定它被哪张 membership 表引用（见 RoleScope 注释）。
model Role {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  scope     RoleScope
  code      String
  name      String
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  tenantMemberships   TenantMembership[]  @relation("TenantMembershipsByRole")
  workspaceMemberships WorkspaceMembership[] @relation("WorkspaceMembershipsByRole")
  permissions         RolePermission[]

  @@unique([tenantId, scope, code])
  @@unique([tenantId, id])
  @@map("roles")
}

// 稳定能力权限码的全局字典（如 'document.upload'）。只判断「能否执行
// 操作」，不参与 acl_scope_key 编译（ADR-0039 决策 2）。
model Permission {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String
  name        String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]

  @@unique([code])
  @@map("permissions")
}

// 角色→能力权限码绑定。能力权限的语义在 T14b 的统一授权入口生效，
// 本批只落数据模型与种子。
model RolePermission {
  id           String   @id @default(uuid(7)) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  role         Role     @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}
